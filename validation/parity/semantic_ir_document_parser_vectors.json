  {
    "id": "roles",
    "fn": "assign_semantic_roles",
    "args": [
      "This is an example of usage.\nTherefore it works.\nIt fails because of input.\nNote: be careful.\nplain sentence"
    ],
    "expected": {
      "roles": [
        {
          "line": 0,
          "role": "example",
          "text": "This is an example of usage."
        },
        {
          "line": 1,
          "role": "conclusion",
          "text": "Therefore it works."
        },
        {
          "line": 2,
          "role": "reason",
          "text": "It fails because of input."
        },
        {
          "line": 3,
          "role": "notice",
          "text": "Note: be careful."
        }
      ],
      "count": 4
    }
  },
