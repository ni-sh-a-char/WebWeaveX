{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebWeaveX Graph",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "max_edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        },
        "anyOf": [
          {
            "required": [
              "kind"
            ]
          },
          {
            "required": [
              "type"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "max_edges": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "x-schema-version": "v21.0.0"
}
