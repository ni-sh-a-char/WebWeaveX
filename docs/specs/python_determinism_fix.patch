+# `compute_global_runtime_fingerprint` is part of this package's public API
+# (mirroring the sibling-package pattern, e.g. core.runtime_graph re-exporting
+# its engine functions). It is exposed lazily via PEP 562 `__getattr__` because
+# eager import would create a cycle:
+#   determinism.global_runtime_fingerprint -> crypto.kaalka_hash_engine
+#     -> crypto.kaalka_runtime_engine -> determinism.normalization
+#     -> (re-enters) determinism.__init__
+# Lazy resolution defers the submodule import until first access, after the
+# crypto modules have finished initialising.
 __all__ = [
     "VOLATILE_RUNTIME_KEYS",
     "normalize_runtime_value",
     "stable_serialize",
     "stable_sort_keys",
+    "compute_global_runtime_fingerprint",
 ]
+
+if TYPE_CHECKING:  # pragma: no cover - typing only
+    from core.determinism.global_runtime_fingerprint import (
+        compute_global_runtime_fingerprint,
+    )
+
+
+def __getattr__(name: str) -> Any:
+    if name == "compute_global_runtime_fingerprint":
+        from core.determinism.global_runtime_fingerprint import (
+            compute_global_runtime_fingerprint as _fn,
+        )
+
+        return _fn
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__() -> list[str]:
+    return sorted(__all__)
