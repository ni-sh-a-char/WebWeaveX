{
  "name": "webweavex",
  "version": "2.1.0",
  "description": "Deterministic runtime cognition infrastructure for humans and AI agents — browser-native replay, reconstruction, and authenticated operational continuity.",
  "license": "Apache-2.0",
  "author": "Piyush Mishra <piyushmishra.professional@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-sh-a-char/WebWeaveX.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/ni-sh-a-char/WebWeaveX/tree/javascript#readme",
  "bugs": {
    "url": "https://github.com/ni-sh-a-char/WebWeaveX/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/piyushmishra00"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests validation --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate:parity": "tsx validation/validateParity.ts",
    "validate:production": "tsx validation/validateProduction.ts",
    "validate:replay": "tsx validation/replay/validateReplay.ts",
    "validate:browser": "tsx validation/browser/validateBrowser.ts",
    "validate:distributed": "tsx validation/distributed/validateDistributed.ts",
    "validate:connectors": "tsx validation/connectors/validateConnectors.ts",
    "validate:semantics": "tsx validation/semantics/validateSemantics.ts",
    "validate:orchestration": "tsx validation/orchestration/validateOrchestration.ts",
    "validate:repository": "tsx validation/repository/validateRepository.ts",
    "validate:documents": "tsx validation/documents/validateDocuments.ts",
    "validate:evidence": "tsx validation/evidence/validateEvidence.ts",
    "validate:streaming": "tsx validation/streaming/validateStreaming.ts",
    "validate:adaptive": "tsx validation/adaptive/validateAdaptive.ts",
    "validate:workflows": "tsx validation/workflows/validateWorkflows.ts",
    "validate:cognition": "tsx validation/cognition/validateCognition.ts",
    "validate:parsers": "tsx validation/parsers/validateParsers.ts",
    "validate:graph": "tsx validation/graph/validateGraph.ts",
    "validate:vm": "tsx validation/vm/validateVm.ts",
    "validate:ecosystem": "tsx validation/validateEcosystem.ts",
    "validate": "npm run validate:ecosystem",
    "reports:final": "tsx validation/generateFinalReports.ts",
    "audit:forensic": "tsx validation/forensic/subsystemAudit.ts",
    "convert:python": "python tools/py2ts/py2ts.py",
    "convergence:audit": "python tools/convergence/forensic_equality_audit.py",
    "convergence:true-equality-audit": "python -B tools/convergence/true_equality_audit.py",
    "convergence:port": "python tools/convergence/port_all.py",
    "convergence:specs": "python tools/specgen/generate_all_specs.py",
    "convergence:validators": "python tools/convergence/generate_validators.py",
    "convergence:vectors": "python tools/runtime_vectors/generate_canonical_vectors.py",
    "convergence:verify-ports": "python tools/convergence/verify_generated_ports.py",
    "convergence:coverage-probe": "python tools/convergence/coverage_probe.py",
    "convergence:semantic-repair": "python tools/convergence/semantic_repair.py",
    "convergence:generate-tests": "python tools/convergence/generate_vector_tests.py",
    "validate:differential": "npx tsx validation/differential/validateDifferential.ts",
    "validate:equivalence": "npx tsx validation/equivalence/runUniversalEquivalence.ts",
    "convergence:verify-port-behavior": "python -B tools/convergence/verify_generated_port_behavior.py",
    "certification:omega": "python -B tools/convergence/omega_certification.py",
    "certification:omega:matrix": "python -B tools/convergence/certification_program.py --skip-probes",
    "certification:omega:probe": "python -B tools/convergence/certification_program.py --limit 200",
    "certification:omega:package": "python -B tools/convergence/batch_package_certify.py",
    "certification:execution:all": "python -B tools/convergence/execution_certify_all.py",
    "omega:audit:python-deps": "python -B tools/omega_final/python_dependency_audit.py",
    "omega:inventory:js": "python -B tools/omega_final/js_inventory.py",
    "omega:certify:npm": "npx tsx tools/omega_final/self_contained_npm_check.ts",
    "omega:reports": "python -B tools/omega_final/emit_omega_reports.py",
    "omega:forensic": "python -B tools/omega_final/forensic_equality.py",
    "omega:sync-vectors": "python -B tools/omega_final/sync_spec_vectors.py",
    "omega:infinity": "python -B tools/omega_final/sync_spec_vectors.py && python -B tools/omega_final/forensic_equality.py && python -B tools/omega_final/emit_omega_infinity_reports.py",
    "omega:final": "python -B tools/omega_final/omega_final_program.py",
    "certification:omega:fast": "python -B tools/convergence/certification_program.py --skip-probes --skip-gates",
    "certification:omega:gates": "python -B tools/convergence/update_certification_gates.py",
    "certification:py2ts-audit": "python -B tools/convergence/py2ts_correctness_audit.py",
    "certification:regenerate": "python -B tools/convergence/regenerate_js_tree.py",
    "certification:engine-matrix": "python -B tools/convergence/engine_execution_matrix.py",
    "validate:realworld": "npx tsx validation/real_world/validateRealWorld.ts",
    "validate:replay-equivalence": "npx tsx validation/replay/replay_equivalence/validateReplayEquivalenceGate.ts",
    "prepublishOnly": "npm run build && npm run test && npm run validate:differential && npm run validate:equivalence"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "kaalka": "5.0.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "webweavex",
    "deterministic",
    "runtime",
    "replay",
    "playwright",
    "browser-automation",
    "runtime-graph",
    "dom-stabilization",
    "authenticated-session",
    "operational-cognition",
    "kaalka",
    "typescript",
    "extraction",
    "reconstruction",
    "runtime-memory"
  ]
}
