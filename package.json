{
  "name": "webweavex",
  "version": "2.0.0",
  "description": "Deterministic runtime extraction infrastructure with replay-safe graphs and Kaalka persistence (native TypeScript)",
  "license": "Apache-2.0",
  "author": "Piyush Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-sh-a-char/WebWeaveX.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/ni-sh-a-char/WebWeaveX/tree/javascript",
  "bugs": {
    "url": "https://github.com/ni-sh-a-char/WebWeaveX/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests validation --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate": "tsx validation/run-real-world-validation.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "webweavex",
    "runtime-extraction",
    "deterministic",
    "playwright",
    "replay",
    "kaalka"
  ]
}
